# ============================================================================
# Root Monorepo - Environment Variables
# ============================================================================
# This file contains shared environment variables used across the monorepo
# Copy this file to .env and fill in your actual values
# Individual apps may have their own .env files (see apps/*/.env.example)

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL Connection URL
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/vcecom
DATABASE_URL=postgresql://postgres:password@localhost:5432/vcecom

# PostgreSQL User (Optional - for Docker Compose)
# Default: postgres
POSTGRES_USER=postgres

# PostgreSQL Password (Optional - for Docker Compose)
# Default: postgres
POSTGRES_PASSWORD=postgres

# PostgreSQL Database Name (Optional - for Docker Compose)
# Default: maindb
POSTGRES_DB=maindb

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis Connection URL
# Format: redis://[:password@]host:port[/db-number]
# Example: redis://localhost:6379
# With password: redis://:password@localhost:6379
REDIS_URL=redis://localhost:6379

# Redis Password (Optional - for Docker Compose)
# Default: (empty)
REDIS_PASSWORD=

# ============================================================================
# Meilisearch Configuration
# ============================================================================

# Meilisearch Host (Optional - for Docker Compose)
# Default: http://localhost:7700 (for local development)
# In Docker: http://meilisearch:7700
# Example: http://localhost:7700
MEILISEARCH_HOST=http://localhost:7700

# Meilisearch API Key (Optional)
# Master key for Meilisearch authentication
# Required for production, optional for development
# If not set, Meilisearch will run without authentication (development only)
MEILISEARCH_API_KEY=

# ============================================================================
# Backend Configuration
# ============================================================================

# Backend Server Port
# Default: 3001
PORT=3001

# Node Environment
# Options: development, production, test, staging
# Default: development
NODE_ENV=development

# ============================================================================
# Docker Compose Configuration (Optional)
# ============================================================================

# MinIO Root User (Optional - for Docker Compose)
# Default: minioadmin
MINIO_ROOT_USER=minioadmin

# MinIO Root Password (Optional - for Docker Compose)
# Default: minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Traefik Admin Password Hash (Optional - for Docker Compose)
# Generate with: htpasswd -nb admin password | sed -e s/\\$/\\$\\$/g
# Example: admin:$$apr1$$xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRAEFIK_ADMIN_PASSWORD_HASH=

# ============================================================================
# Development Tools (Optional)
# ============================================================================

# Admin User Seed Email (Optional)
# Email for the default admin user created during database seeding
ADMIN_EMAIL=admin@vcecom.local

# Admin User Seed Password (Optional)
# Password for the default admin user created during database seeding
ADMIN_PASSWORD=Admin@123

# GitHub Personal Access Token (Optional)
# Used for changelog generation and GitHub API access
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# Mistral API Key (Optional)
# Used for changelog generation with AI
# Get from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# ============================================================================
# Health Check Configuration (Optional)
# ============================================================================

# Health Check Base URLs (Optional)
# Comma-separated list of base URLs to check during health checks
# Example: http://localhost:3001,https://api.example.com
HEALTH_CHECK_BASE_URLS=

# Health Check Endpoint (Optional)
# Health endpoint path to query (defaults to /_health)
HEALTH_CHECK_ENDPOINT=/_health

# Health Check Timeout (Optional)
# Timeout in milliseconds (defaults to 5000ms)
HEALTH_CHECK_TIMEOUT_MS=5000

# ============================================================================
# Notes
# ============================================================================
# - This file is for shared variables used across the monorepo
# - Individual apps have their own .env.example files:
#   - apps/backend/.env.example - Backend API configuration
#   - apps/admin/.env.example - Admin frontend configuration
#   - apps/storefront/.env.example - Storefront frontend configuration
# - Never commit actual .env files with real secrets
# - Use .env.local for local development (gitignored)
# - For simplest setup, see .env.simple files