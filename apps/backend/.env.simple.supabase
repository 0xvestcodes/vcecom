# ============================================================================
# Minimal .env Setup with Supabase Storage - Copy to .env and customize
# ============================================================================

# ============================================================================
# REQUIRED - Core Configuration
# ============================================================================

# Database (REQUIRED)
DATABASE_URL=postgresql://postgres:password@localhost:5432/vcecom

# Redis (REQUIRED)
REDIS_URL=redis://localhost:6379

# JWT Secret (REQUIRED - Generate: openssl rand -base64 32)
JWT_SECRET=change-me-in-production-minimum-32-characters-long

# ============================================================================
# REQUIRED - Storage (Supabase)
# ============================================================================

STORAGE_PROVIDER=supabase
# Your Supabase project URL (found in Supabase Dashboard > Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Use either SUPABASE_STORAGE_KEY (service role key - full access) or SUPABASE_ANON_KEY (public key)
# Service role key: Found in Supabase Dashboard > Settings > API > service_role (secret)
# Anon key: Found in Supabase Dashboard > Settings > API > anon (public)
SUPABASE_STORAGE_KEY=your-service-role-key-here
# Alternative: SUPABASE_ANON_KEY=your-anon-key-here

# Storage bucket name (create in Supabase Dashboard > Storage)
STORAGE_BUCKET=vcecom

# ============================================================================
# OPTIONAL - Health Check Endpoints
# ============================================================================

# Comma-separated list of base URLs to check
# Example: http://localhost:3001,https://api.example.com
# HEALTH_CHECK_BASE_URLS=http://localhost:3001

# Health endpoint path (defaults to /_health)
# HEALTH_CHECK_ENDPOINT=/_health

# Timeout in milliseconds (defaults to 5000ms)
# HEALTH_CHECK_TIMEOUT_MS=5000

# ============================================================================
# OPTIONAL - CORS (for local development)
# ============================================================================

BACKEND_URL=http://localhost:3001
STOREFRONT_URL=http://localhost:3002
ADMIN_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# ============================================================================
# OPTIONAL - Server
# ============================================================================

NODE_ENV=development
PORT=3001
