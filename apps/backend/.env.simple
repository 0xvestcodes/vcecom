# ============================================================================
# Minimal .env Setup - Copy to .env and customize
# ============================================================================

# ============================================================================
# REQUIRED - Core Configuration
# ============================================================================

# Database (REQUIRED)
DATABASE_URL=postgresql://postgres:password@localhost:5432/vcecom

# Redis (REQUIRED)
REDIS_URL=redis://localhost:6379

# JWT Secret (REQUIRED - Generate: openssl rand -base64 32)
JWT_SECRET=change-me-in-production-minimum-32-characters-long

# ============================================================================
# REQUIRED - Storage (MinIO)
# ============================================================================

STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# ============================================================================
# OPTIONAL - Search (Meilisearch)
# ============================================================================

# If running locally with Docker: http://localhost:7700
# If running in Docker network: http://meilisearch:7700
MEILISEARCH_HOST=http://localhost:7700

# Disable search if not needed:
# SEARCH_INDEXING_ENABLED=false

# ============================================================================
# OPTIONAL - Health Check Endpoints
# ============================================================================

# Comma-separated list of base URLs to check
# Example: http://localhost:3001,https://api.example.com
# HEALTH_CHECK_BASE_URLS=http://localhost:3001

# Health endpoint path (defaults to /_health)
# HEALTH_CHECK_ENDPOINT=/_health

# Timeout in milliseconds (defaults to 5000ms)
# HEALTH_CHECK_TIMEOUT_MS=5000

# ============================================================================
# OPTIONAL - CORS (for local development)
# ============================================================================

BACKEND_URL=http://localhost:3001
STOREFRONT_URL=http://localhost:3002
ADMIN_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# ============================================================================
# OPTIONAL - Server
# ============================================================================

NODE_ENV=development
PORT=3001
