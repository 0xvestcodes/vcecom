{
  "name": "@vestcodes/vcecom-backend",
  "version": "0.0.1",
  "description": "NestJS backend API for VCEcom ecommerce platform",
  "author": "Vestcodes <contact@vestcodes.co>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/generate-build-info.js && nest build",
    "generate-build-info": "node scripts/generate-build-info.js",
    "dev": "nodemon",
    "start": "node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "check-types": "node scripts/generate-build-info.js && tsc --noEmit --project tsconfig.build.json",
    "predeploy": "node scripts/predeploy.js",
    "predeploy:generate": "node scripts/predeploy.js --skip-migrate",
    "predeploy:migrate": "node scripts/predeploy.js --skip-generate",
    "db:generate": "cd ../../packages/db && pnpm db:generate",
    "db:migrate": "cd ../../packages/db && pnpm db:migrate:run",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./jest-e2e.config.js",
    "cli:seed": "ts-node -r tsconfig-paths/register src/cli/commands/seed.command.ts",
    "cli:api-key": "ts-node -r tsconfig-paths/register src/cli/commands/api-key.command.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.952.0",
    "@aws-sdk/s3-request-presigner": "^3.952.0",
    "@elastic/elasticsearch": "^8.19.1",
