    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.4",
    "@vcecom/db": "workspace:*",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.66.4",
    "cashfree-pg-sdk-nodejs": "^2.0.2",
    "class-transformer": "^0.5.1",
