# ============================================================================
# Backend API - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# All variables marked as REQUIRED must be set for the application to start

# ============================================================================
# Core Application Configuration
# ============================================================================

# Node Environment (REQUIRED)
# Options: development, production, test, staging
# Default: development
NODE_ENV=development

# Server Port (REQUIRED)
# Port on which the backend API will listen
# Default: 3001
PORT=3001

# ============================================================================
# Database Configuration (REQUIRED)
# ============================================================================

# PostgreSQL Connection URL (REQUIRED)
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/vcecom
# In production, ensure SSL is enabled: postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/vcecom

# ============================================================================
# Redis Configuration (REQUIRED)
# ============================================================================

# Redis Connection URL (REQUIRED)
# Format: redis://[:password@]host:port[/db-number]
# Example: redis://localhost:6379
# With password: redis://:password@localhost:6379
REDIS_URL=redis://localhost:6379

# ============================================================================
# JWT Authentication Configuration (REQUIRED)
# ============================================================================

# JWT Secret Key (REQUIRED)
# Must be at least 32 characters long
# Generate a strong random secret: openssl rand -base64 32
# NEVER use default values in production!
JWT_SECRET=change-me-in-production-minimum-32-characters-long

# JWT Access Token Expiration (Optional)
# Default: 1d (1 day)
# Format: number + unit (s, m, h, d)
# Examples: 15m, 1h, 7d, 30d
JWT_EXPIRES_IN=1d

# JWT Refresh Secret (Optional but Recommended)
# Must be at least 32 characters long if provided
# Generate a different secret from JWT_SECRET
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-characters

# JWT Refresh Token Expiration (Optional)
# Default: 7d (7 days)
JWT_REFRESH_EXPIRES_IN=7d

# Admin Access Token Expiration (Optional)
# Default: 15m (15 minutes)
# Shorter expiration for admin tokens for better security
ADMIN_ACCESS_TOKEN_EXPIRES_IN=15m

# ============================================================================
# JWT Secret Rotation Configuration (Optional)
# ============================================================================

# Enable JWT Secret Rotation (Optional)
# Set to "true" to enable automatic JWT secret rotation
# Default: false
JWT_SECRET_ROTATION_ENABLED=false

# JWT Secret Rotation Interval (Optional)
# Number of days between secret rotations
# Default: 30
JWT_SECRET_ROTATION_INTERVAL_DAYS=30

# JWT Secret Grace Period (Optional)
# Number of days to keep old secret valid after rotation
# Default: 7
JWT_SECRET_GRACE_PERIOD_DAYS=7

# JWT Secret Encryption Key (Optional)
# Encryption key for storing rotated secrets securely
# Required if JWT_SECRET_ROTATION_ENABLED=true
JWT_SECRET_ENCRYPTION_KEY=

# ============================================================================
# CORS Configuration (Optional but Recommended)
# ============================================================================

# Backend URL (Optional)
# Public URL of the backend API
# Used for CORS and internal redirects
BACKEND_URL=http://localhost:3001

# Storefront URL (Optional)
# Public URL of the storefront application
# Used for CORS configuration
STOREFRONT_URL=http://localhost:3002

# Admin URL (Optional)
# Public URL of the admin application
# Used for CORS configuration
ADMIN_URL=http://localhost:3000

# Allowed Origins (Optional)
# Comma-separated list of allowed CORS origins
# Overrides individual URL settings above
# Example: https://storefront.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# ============================================================================
# Storage Configuration
# ============================================================================

# Storage Provider (REQUIRED)
# Options: minio, s3, supabase
# Default: minio
STORAGE_PROVIDER=minio

# Storage Bucket Name (Optional)
# Default: vcecom
STORAGE_BUCKET=vcecom

# Product Media Bucket (Optional)
# Separate bucket for product images/media
# If not set, uses STORAGE_BUCKET
STORAGE_PRODUCT_MEDIA_BUCKET=

# Uploads Bucket (Optional)
# Separate bucket for user uploads
# If not set, uses STORAGE_BUCKET
STORAGE_UPLOADS_BUCKET=

# Internal Bucket (Optional)
# Separate bucket for internal files
# If not set, uses STORAGE_BUCKET
STORAGE_INTERNAL_BUCKET=

# CDN URL (Optional)
# CDN URL for serving media files
# Example: https://cdn.example.com
CDN_URL=

# Media Cache Max Age (Optional)
# Cache-Control max-age header for media files (in seconds)
# Default: 31536000 (1 year)
MEDIA_CACHE_MAX_AGE=31536000

# ----------------------------------------------------------------------------
# MinIO Configuration (Required if STORAGE_PROVIDER=minio)
# ----------------------------------------------------------------------------

# MinIO Endpoint (Required for MinIO)
# Format: host:port
# Example: localhost:9000 or minio.example.com:9000
MINIO_ENDPOINT=localhost:9000

# MinIO Access Key (Required for MinIO)
# MinIO root user access key
MINIO_ACCESS_KEY=minioadmin

# MinIO Secret Key (Required for MinIO)
# MinIO root user secret key
MINIO_SECRET_KEY=minioadmin

# MinIO Use SSL (Optional)
# Set to "true" if MinIO uses HTTPS
# Default: false
MINIO_USE_SSL=false

# MinIO Public URL (Optional)
# Public URL for accessing MinIO objects
# Used for generating public image URLs
# Example: https://storage.example.com
MINIO_PUBLIC_URL=http://localhost:9000

# ----------------------------------------------------------------------------
# AWS S3 Configuration (Required if STORAGE_PROVIDER=s3)
# ----------------------------------------------------------------------------

# AWS Access Key ID (Required for S3)
# Your AWS IAM access key ID
AWS_ACCESS_KEY_ID=your-aws-access-key-id

# AWS Secret Access Key (Required for S3)
# Your AWS IAM secret access key
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS Region (Optional)
# Default: us-east-1
AWS_REGION=us-east-1

# AWS S3 Public URL (Optional)
# Public URL for accessing S3 objects
# Example: https://your-bucket.s3.amazonaws.com
AWS_S3_PUBLIC_URL=https://your-bucket.s3.amazonaws.com

# ----------------------------------------------------------------------------
# Supabase Storage Configuration (Required if STORAGE_PROVIDER=supabase)
# ----------------------------------------------------------------------------

# Supabase Project URL (Required for Supabase)
# Your Supabase project URL
# Example: https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase Storage Key (Required for Supabase)
# Service role key or storage key for Supabase Storage
SUPABASE_STORAGE_KEY=your-supabase-storage-key

# Supabase Anonymous Key (Optional)
# Can be used instead of storage key for public operations
SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================================================
# Payment Gateway Configuration (Razorpay)
# ============================================================================

# Razorpay Key ID (Optional)
# Your Razorpay API key ID
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id

# Razorpay Key Secret (Optional)
# Your Razorpay API key secret
# Keep this secret! Never expose in frontend code.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret (Optional)
# Secret for verifying webhook signatures
# Set in Razorpay dashboard under Webhooks section
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Razorpay Request Timeout (Optional)
# Timeout in milliseconds for Razorpay API requests
# Default: 10000 (10 seconds)
RAZORPAY_TIMEOUT_MS=10000

# ============================================================================
# Payment Gateway Configuration (Cashfree)
# ============================================================================

# Cashfree App ID (Optional)
# Your Cashfree App ID
# Get from: https://merchant.cashfree.com/developers/api-credentials
CASHFREE_APP_ID=your_cashfree_app_id

# Cashfree Secret Key (Optional)
# Your Cashfree Secret Key
# Keep this secret! Never expose in frontend code.
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# Cashfree Webhook Secret (Optional)
# Secret for verifying webhook signatures
# Set in Cashfree dashboard under Webhooks section
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# Cashfree Environment (Optional)
# Options: sandbox, production
# Default: sandbox
CASHFREE_ENVIRONMENT=sandbox

# Cashfree Request Timeout (Optional)
# Timeout in milliseconds for Cashfree API requests
# Default: 10000 (10 seconds)
CASHFREE_TIMEOUT_MS=10000

# ============================================================================
# Payment Gateway Configuration (PayU)
# ============================================================================

# PayU Merchant Key (Optional)
# Your PayU merchant key
# Get from: https://dashboard.payu.in/
PAYU_MERCHANT_KEY=your_payu_merchant_key

# PayU Merchant Salt (Optional)
# Your PayU merchant salt
# Keep this secret! Never expose in frontend code.
PAYU_MERCHANT_SALT=your_payu_merchant_salt

# PayU Webhook Secret (Optional)
# Secret for verifying webhook signatures
PAYU_WEBHOOK_SECRET=your_payu_webhook_secret

# PayU Environment (Optional)
# Options: sandbox, production
# Default: sandbox
PAYU_ENVIRONMENT=sandbox

# PayU Request Timeout (Optional)
# Timeout in milliseconds for PayU API requests
# Default: 10000 (10 seconds)
PAYU_TIMEOUT_MS=10000

# ============================================================================
# Shipping Provider Configuration (Optional)
# ============================================================================

# Shiprocket Email (Optional)
# Your Shiprocket account email
SHIPROCKET_EMAIL=your-email@example.com

# Shiprocket Password (Optional)
# Your Shiprocket account password
SHIPROCKET_PASSWORD=your-password

# Nimbus Post API Key (Optional)
# Your Nimbus Post API key
NIMBUS_POST_API_KEY=your-nimbus-post-api-key

# Nimbus Post API Secret (Optional)
# Your Nimbus Post API secret
NIMBUS_POST_API_SECRET=your-nimbus-post-api-secret

# ============================================================================
# Currency & Exchange Rate Configuration (Optional)
# ============================================================================

# FX Provider (Optional)
# Options: exchange-rate-api, fixer-io, currencylayer
# Default: exchange-rate-api
FX_PROVIDER=exchange-rate-api

# FX Provider API Key (Optional)
# API key for the selected FX provider
# Can also use provider-specific keys: EXCHANGE_RATE_API_KEY, FIXER_IO_API_KEY, CURRENCYLAYER_API_KEY
FX_PROVIDER_API_KEY=your_fx_provider_api_key

# Exchange Rate API Key (Optional)
# Alternative to FX_PROVIDER_API_KEY for ExchangeRate-API
# Get from: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# Fixer.io API Key (Optional)
# Alternative to FX_PROVIDER_API_KEY for Fixer.io
# Get from: https://fixer.io/
FIXER_IO_API_KEY=your_fixer_io_api_key

# CurrencyLayer API Key (Optional)
# Alternative to FX_PROVIDER_API_KEY for CurrencyLayer
# Get from: https://currencylayer.com/
CURRENCYLAYER_API_KEY=your_currencylayer_api_key

# ============================================================================
# Search Configuration (Optional)
# ============================================================================

# Search Provider (Optional)
# Options: meilisearch, elasticsearch, opensearch
# Default: meilisearch
SEARCH_PROVIDER=meilisearch

# Enable Search Indexing (Optional)
# Set to "true" to enable automatic search indexing
# Default: true
SEARCH_INDEXING_ENABLED=true

# Search Batch Size (Optional)
# Number of documents to index per batch
# Default: 100
SEARCH_BATCH_SIZE=100

# Search Reindex Rate Limit (Optional)
# Maximum number of documents to reindex per second
# Default: 1000
SEARCH_REINDEX_RATE_LIMIT=1000

# ----------------------------------------------------------------------------
# Meilisearch Configuration (Required if SEARCH_PROVIDER=meilisearch)
# ----------------------------------------------------------------------------

# Meilisearch Host (Required for Meilisearch)
# Meilisearch server URL
# Example: http://localhost:7700 (for local development)
# In Docker: http://meilisearch:7700
MEILISEARCH_HOST=http://localhost:7700

# Meilisearch API Key (Optional)
# Master key for Meilisearch authentication
# Required for production, optional for development
# If not set, Meilisearch will run without authentication (development only)
MEILISEARCH_API_KEY=

# ----------------------------------------------------------------------------
# Elasticsearch Configuration (Required if SEARCH_PROVIDER=elasticsearch)
# ----------------------------------------------------------------------------

# Elasticsearch Host (Required for Elasticsearch)
# Elasticsearch server URL
# Example: http://localhost:9200
ELASTICSEARCH_HOST=http://localhost:9200

# Elasticsearch API Key (Optional)
# API key for Elasticsearch authentication
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key

# Elasticsearch Username (Optional)
# Username for Elasticsearch authentication (alternative to API key)
ELASTICSEARCH_USERNAME=elastic

# Elasticsearch Password (Optional)
# Password for Elasticsearch authentication (alternative to API key)
ELASTICSEARCH_PASSWORD=your_elasticsearch_password

# ----------------------------------------------------------------------------
# OpenSearch Configuration (Required if SEARCH_PROVIDER=opensearch)
# ----------------------------------------------------------------------------

# OpenSearch Host (Required for OpenSearch)
# OpenSearch server URL
# Example: http://localhost:9200
OPENSEARCH_HOST=http://localhost:9200

# OpenSearch API Key (Optional)
# API key for OpenSearch authentication
OPENSEARCH_API_KEY=your_opensearch_api_key

# OpenSearch Username (Optional)
# Username for OpenSearch authentication (alternative to API key)
OPENSEARCH_USERNAME=admin

# OpenSearch Password (Optional)
# Password for OpenSearch authentication (alternative to API key)
OPENSEARCH_PASSWORD=your_opensearch_password

# ============================================================================
# Queue Configuration (Optional)
# ============================================================================

# Queue Default Retry Attempts (Optional)
# Default number of retry attempts for failed jobs
# Default: 3
QUEUE_DEFAULT_RETRY_ATTEMPTS=3

# Queue Default Backoff Delay (Optional)
# Default backoff delay in milliseconds between retries
# Default: 1000 (1 second)
QUEUE_DEFAULT_BACKOFF_DELAY=1000

# Queue Concurrency (Optional)
# Number of concurrent job processors
# Default: 5
QUEUE_CONCURRENCY=5

# Queue Remove On Complete (Optional)
# Set to "true" to remove completed jobs from queue
# Default: true
QUEUE_REMOVE_ON_COMPLETE=true

# Queue Remove On Fail (Optional)
# Set to "true" to remove failed jobs from queue
# Default: false
QUEUE_REMOVE_ON_FAIL=false

# ============================================================================
# Email Configuration (Optional)
# ============================================================================

# Enable Email (Optional)
# Set to "true" to enable email sending
# Default: false
EMAIL_ENABLED=false

# SMTP Host (Required if EMAIL_ENABLED=true)
# SMTP server hostname
# Example: smtp.gmail.com, smtp.sendgrid.net
SMTP_HOST=smtp.gmail.com

# SMTP Port (Optional)
# SMTP server port
# Default: 587 (TLS), use 465 for SSL
SMTP_PORT=587

# SMTP Secure (Optional)
# Set to "true" if using SSL/TLS
# Default: false (use STARTTLS)
SMTP_SECURE=false

# SMTP User (Required if EMAIL_ENABLED=true)
# SMTP authentication username
SMTP_USER=your-email@example.com

# SMTP Password (Required if EMAIL_ENABLED=true)
# SMTP authentication password or app password
SMTP_PASSWORD=your-smtp-password

# Email From Address (Optional)
# Default sender email address
# Must be a valid email address
EMAIL_FROM=noreply@example.com

# ============================================================================
# SMS Configuration (Optional)
# ============================================================================

# Enable SMS (Optional)
# Set to "true" to enable SMS sending
# Default: false
SMS_ENABLED=false

# SMS Provider (Optional)
# Options: twilio, aws-sns, mock
# Default: mock (for development/testing)
SMS_PROVIDER=mock

# SMS From Number (Optional)
# Default sender phone number
# Format: +1234567890
SMS_FROM_NUMBER=+1234567890

# ----------------------------------------------------------------------------
# Twilio Configuration (Required if SMS_PROVIDER=twilio)
# ----------------------------------------------------------------------------

# Twilio Account SID (Required for Twilio)
# Your Twilio Account SID
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid

# Twilio Auth Token (Required for Twilio)
# Your Twilio Auth Token
# Keep this secret!
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio Phone Number (Required for Twilio)
# Your Twilio phone number
# Format: +1234567890
TWILIO_PHONE_NUMBER=+1234567890

# ----------------------------------------------------------------------------
# AWS SNS Configuration (Required if SMS_PROVIDER=aws-sns)
# ----------------------------------------------------------------------------

# AWS SNS Region (Optional)
# AWS region for SNS service
# Default: us-east-1
AWS_SNS_REGION=us-east-1

# AWS SNS Access Key ID (Required for AWS SNS)
# Your AWS IAM access key ID for SNS
AWS_SNS_ACCESS_KEY_ID=your_aws_sns_access_key_id

# AWS SNS Secret Access Key (Required for AWS SNS)
# Your AWS IAM secret access key for SNS
AWS_SNS_SECRET_ACCESS_KEY=your_aws_sns_secret_access_key

# ============================================================================
# Abandoned Cart Configuration (Optional)
# ============================================================================

# Abandoned Cart Detection Hours (Optional)
# Hours after which a cart is considered abandoned
# Default: 1
ABANDONED_CART_DETECTION_HOURS=1

# Abandoned Cart Minimum Value (Optional)
# Minimum cart value to trigger abandoned cart recovery
# Default: 0 (all carts)
ABANDONED_CART_MIN_VALUE=0

# Recovery Email Delay Hours (Optional)
# Hours to wait before sending recovery email
# Default: 1
RECOVERY_EMAIL_DELAY_HOURS=1

# Recovery SMS Delay Hours (Optional)
# Hours to wait before sending recovery SMS
# Default: 2
RECOVERY_SMS_DELAY_HOURS=2

# Max Recovery Attempts (Optional)
# Maximum number of recovery attempts per cart
# Default: 3
MAX_RECOVERY_ATTEMPTS=3

# Recovery Discount Percentage (Optional)
# Discount percentage to offer in recovery campaigns
# Default: 10
RECOVERY_DISCOUNT_PERCENTAGE=10

# ============================================================================
# Logging Configuration (Optional)
# ============================================================================

# Log Level (Optional)
# Options: fatal, error, warn, info, debug, trace
# Default: info
# Use "debug" or "trace" for development, "info" or "warn" for production
LOG_LEVEL=info

# Pretty Print Logs (Optional)
# Set to "true" for human-readable logs (development)
# Set to "false" for JSON logs (production)
# Default: false
LOG_PRETTY=false

# ============================================================================
# OpenTelemetry Tracing Configuration (Optional)
# ============================================================================

# Enable Tracing (Optional)
# Set to "true" to enable distributed tracing
# Default: false
OTEL_TRACE_ENABLED=false

# Tracing Sampling Rate (Optional)
# Sampling rate between 0.0 and 1.0
# 0.1 = 10% of requests will be traced
# Default: 0.1
OTEL_TRACE_SAMPLING=0.1

# OTLP Endpoint (Optional)
# OpenTelemetry Protocol endpoint for trace export
# Example: http://localhost:4318/v1/traces
# Alternative to OTEL_EXPORTER_ZIPKIN_ENDPOINT
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# OTLP Traces Endpoint (Optional)
# OpenTelemetry Protocol traces endpoint
# Example: http://localhost:4318/v1/traces
# Overrides OTEL_EXPORTER_OTLP_ENDPOINT for traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Service Name (Optional)
# Service name for tracing
# Default: vcecom-backend
OTEL_SERVICE_NAME=vcecom-backend

# ============================================================================
# Rate Limiting Configuration (Optional)
# ============================================================================

# Admin Login Rate Limit (Optional)
# Maximum number of login attempts per window
# Default: 100
ADMIN_LOGIN_RATE_LIMIT=100

# Admin Login Rate Window (Optional)
# Time window in seconds for rate limiting
# Default: 300 (5 minutes)
ADMIN_LOGIN_RATE_WINDOW=300

# ============================================================================
# Prometheus Metrics Configuration (Optional)
# ============================================================================

# Enable Prometheus Metrics (Optional)
# Set to "true" to enable Prometheus metrics endpoint at /metrics
# Default: false
PROMETHEUS_ENABLED=false

# ============================================================================
# Security Configuration (Optional)
# ============================================================================

# Admin Session Signing Enabled (Optional)
# Set to "true" to enable session signing for admin authentication
# Default: true
ADMIN_SESSION_SIGNING_ENABLED=true

# Security Alert Risk Threshold (Optional)
# Risk score threshold for security alerts
# Default: 70
SECURITY_ALERT_RISK_THRESHOLD=70

# Security Alert Login Anomaly Threshold (Optional)
# Threshold for login anomaly detection
# Default: 60
SECURITY_ALERT_LOGIN_ANOMALY_THRESHOLD=60

# Security Alert Block Threshold (Optional)
# Risk score threshold for blocking requests
# Default: 80
SECURITY_ALERT_BLOCK_THRESHOLD=80

# IP Reputation Enabled (Optional)
# Set to "true" to enable IP reputation checking
# Default: true
IP_REPUTATION_ENABLED=true

# IP Reputation Cache TTL Hours (Optional)
# Hours to cache IP reputation data
# Default: 24
IP_REPUTATION_CACHE_TTL_HOURS=24

# IP Reputation Block Threshold (Optional)
# Risk score threshold for blocking IPs
# Default: 70
IP_REPUTATION_BLOCK_THRESHOLD=70

# IP Heuristics Enabled (Optional)
# Set to "true" to enable IP heuristic analysis
# Default: true
IP_HEURISTICS_ENABLED=true

# Risk Alert Threshold Warning (Optional)
# Risk score threshold for warning alerts
# Default: 50
RISK_ALERT_THRESHOLD_WARNING=50

# Risk Alert Threshold Critical (Optional)
# Risk score threshold for critical alerts
# Default: 75
RISK_ALERT_THRESHOLD_CRITICAL=75

# HSTS Max Age (Optional)
# Strict-Transport-Security max-age header value (in seconds)
# Default: 31536000 (1 year)
HSTS_MAX_AGE=31536000

# HSTS Include Subdomains (Optional)
# Set to "true" to include subdomains in HSTS
# Default: true
HSTS_INCLUDE_SUBDOMAINS=true

# HSTS Preload (Optional)
# Set to "true" to enable HSTS preload
# Default: false
HSTS_PRELOAD=false

# CSP Enabled (Optional)
# Set to "true" to enable Content Security Policy headers
# Default: true
CSP_ENABLED=true

# Expect-CT Enabled (Optional)
# Set to "true" to enable Certificate Transparency headers
# Default: false
EXPECT_CT_ENABLED=false

# ============================================================================
# Database Backup Configuration (Optional)
# ============================================================================

# Enable Database Backups (Optional)
# Set to "true" to enable automated database backups
# Default: false (enabled automatically if SUPABASE_URL is set)
DB_BACKUP_ENABLED=false

# Database Backup Retention Days (Optional)
# Number of days to keep local backup files
# Default: 30
DB_BACKUP_RETENTION_DAYS=30

# Backup Directory (Optional)
# Local directory for storing backup files
# Default: /tmp/backups
BACKUP_DIR=/tmp/backups

# ============================================================================
# Deployment Configuration (Optional)
# ============================================================================

# Deployment Region (Optional)
# Region identifier for deployment tracking
# Example: us-east-1, eu-west-1, fra1
DEPLOYMENT_REGION=

# ============================================================================
# Seller Configuration (Optional)
# ============================================================================

# Seller State (Optional)
# Default seller state for tax calculations
# Default: Maharashtra
SELLER_STATE=Maharashtra

# ============================================================================
# Cart & Reservation Configuration (Optional)
# ============================================================================

# Maximum Reservations Per Device Fingerprint (Optional)
# Maximum number of active reservations allowed per device fingerprint
# Set to 0 to disable the limit (unlimited reservations)
# Default: 3
# Useful for testing: set to 0 to allow unlimited reservations
MAX_RESERVATIONS_PER_FINGERPRINT=3

# ============================================================================
# Health Check Configuration (Optional)
# ============================================================================

# Health Check Base URLs (Optional)
# Comma-separated list of base URLs to check during health checks
# Example: http://localhost:3001,https://api.example.com
# If not set, endpoint health checks are skipped
HEALTH_CHECK_BASE_URLS=

# Health Check Endpoint (Optional)
# Health endpoint path to query (appended to base URLs)
# Default: /_health
HEALTH_CHECK_ENDPOINT=/_health

# Health Check Timeout (Optional)
# Timeout in milliseconds for each endpoint check
# Default: 5000 (5 seconds)
HEALTH_CHECK_TIMEOUT_MS=5000
