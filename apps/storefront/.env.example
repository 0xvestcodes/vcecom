# ============================================================================
# Storefront Frontend - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Next.js automatically loads .env.local files

# ============================================================================
# API Configuration (REQUIRED)
# ============================================================================

# Backend API URL (REQUIRED)
# Public URL of the backend API
# This is used by client-side code and must be publicly accessible
# In production, this must be set to your actual backend URL
# Example: https://api.example.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================================================
# Payment Gateway Configuration (REQUIRED for checkout)
# ============================================================================

# Razorpay Key ID (REQUIRED)
# Your Razorpay API key ID (public key - safe to expose)
# Get from: https://dashboard.razorpay.com/app/keys
# This is the PUBLIC key and is safe to expose in frontend code
# Example: rzp_test_xxxxxxxxxxxxx (test) or rzp_live_xxxxxxxxxxxxx (production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ============================================================================
# Environment Configuration (Optional)
# ============================================================================

# Node Environment (Optional)
# Options: development, production, test
# Default: production
# Next.js sets this automatically during build, but you can override
# NODE_ENV=production

# ============================================================================
# Notes
# ============================================================================
# - All variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - Razorpay Key ID is public and safe to expose
# - Razorpay Key Secret and Webhook Secret are configured in backend only
# - Use .env.local for local development (gitignored)
# - Use Vercel/Netlify environment variables for production