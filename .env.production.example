# ============================================================================
# Production Environment Variables
# ============================================================================
# Copy this file to .env.production and update with your production values
# DO NOT commit .env.production to version control

# ============================================================================
# Docker Registry Configuration
# ============================================================================
GHCR_REGISTRY=ghcr.io
GHCR_ORG=vestcodes
IMAGE_TAG=latest

# ============================================================================
# Database Configuration
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=maindb

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ============================================================================
# Meilisearch Configuration
# ============================================================================
MEILISEARCH_API_KEY=CHANGE_ME_STRONG_MEILISEARCH_KEY
MEILISEARCH_LOG_LEVEL=INFO

# ============================================================================
# MinIO Configuration
# ============================================================================
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD

# ============================================================================
# JWT Configuration (REQUIRED)
# ============================================================================
# Generate strong secrets: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_SECRET
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_ACCESS_TOKEN_EXPIRES_IN=15m

# ============================================================================
# Payment Gateway Configuration (Razorpay)
# ============================================================================
RAZORPAY_KEY_ID=CHANGE_ME_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_RAZORPAY_WEBHOOK_SECRET

# ============================================================================
# Application URLs
# ============================================================================
BACKEND_URL=https://api.vcecom.vestcodes.co
# Optional: Frontend URLs for CORS (if using separate frontend deployments)
STOREFRONT_URL=https://storefront.vcecom.vestcodes.co
ADMIN_URL=https://admin.vcecom.vestcodes.co

# ============================================================================
# Traefik Configuration
# ============================================================================
LETSENCRYPT_EMAIL=contact@vestcodes.co
TRAEFIK_DASHBOARD_HOST=traefik.vcecom.vestcodes.co
# Generate with: htpasswd -nb admin password | base64
TRAEFIK_AUTH_USERS=admin:$$apr1$$8K8v8K8v$$8K8v8K8v8K8v8K8v
TRAEFIK_LOG_LEVEL=INFO

# ============================================================================
# Service Hosts (Domain Names)
# ============================================================================
BACKEND_HOST=api.vcecom.vestcodes.co
MINIO_CONSOLE_HOST=minio.vcecom.vestcodes.co
MINIO_API_HOST=api.minio.vcecom.vestcodes.co
ZIPKIN_HOST=telemetry.vcecom.vestcodes.co

# ============================================================================
# CORS Configuration
# ============================================================================
ALLOWED_ORIGINS=https://api.vcecom.vestcodes.co,https://storefront.vcecom.vestcodes.co,https://admin.vcecom.vestcodes.co

# ============================================================================
# Storage Configuration
# ============================================================================
STORAGE_PROVIDER=minio
STORAGE_BUCKET=vcecom
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=https://api.minio.vcecom.vestcodes.co/vcecom

# ============================================================================
# Search Configuration
# ============================================================================
SEARCH_PROVIDER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=production
PORT=3001
LOG_LEVEL=info
LOG_PRETTY=false

# ============================================================================
# Observability Configuration
# ============================================================================
OTEL_TRACE_ENABLED=true
OTEL_TRACE_SAMPLING=0.1
OTEL_EXPORTER_ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
OTEL_SERVICE_NAME=vcecom-backend
DEPLOYMENT_REGION=fra1

# ============================================================================
# Rate Limiting
# ============================================================================
ADMIN_LOGIN_RATE_LIMIT=100
ADMIN_LOGIN_RATE_WINDOW=300

# ============================================================================
# Redis Configuration (Advanced)
# ============================================================================
REDIS_MAX_MEMORY=256mb

# ============================================================================
# GitHub Token (for GHCR login in deployment script)
# ============================================================================
# Optional: Set this if you want to use automated GHCR login
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_USERNAME=your-username
