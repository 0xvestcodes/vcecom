{
  "name": "@vestcodes/vcecom",
  "version": "0.0.0",
  "description": "Lightweight ecommerce backend built with NestJS, Drizzle ORM, and Next.js - India-focused with Razorpay, Shiprocket, and GST compliance",
  "private": true,
  "license": "UNLICENSED",
  "author": "Vestcodes <contact@vestcodes.co>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vestcodes/vcecom.git"
  },
  "homepage": "https://vestcodes.co",
  "bugs": {
    "url": "https://github.com/Vestcodes/vcecom/issues"
  },
  "keywords": [
    "ecommerce",
    "nestjs",
    "drizzle",
    "nextjs",
    "razorpay",
    "shiprocket",
    "india",
    "gst",
    "monorepo",
    "turborepo"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "check-types": "turbo run check-types",
    "commitlint": "commitlint",
    "changelog": "git-cliff",
    "changelog:unreleased": "git-cliff --unreleased",
    "seed:ecom": "tsx scripts/seed-ecom.ts",
    "semantic-release": "semantic-release",
    "semantic-release:beta": "semantic-release --config .releaserc.beta.js",
    "semantic-release:prod": "semantic-release --config .releaserc.prod.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@docusaurus/theme-mermaid": "^3.9.2",
    "@octokit/rest": "^21.0.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^24.10.1",
    "dotenv": "^16.4.5",
    "git-cliff": "^2.10.1",
    "husky": "^9.1.7",
    "nodemon": "^3.1.11",
    "semantic-release": "^25.0.2",
    "tsx": "^4.19.2",
    "turbo": "^2.6.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "argon2": "^0.44.0",
    "esbuild": "^0.27.2",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.3",
      "@types/react-dom": "^18.3.0"
    }
  }
}
