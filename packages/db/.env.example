# ============================================================================
# Database Package - Environment Variables
# ============================================================================
# This package handles database migrations and seeding
# Copy this file to .env and fill in your actual values

# ============================================================================
# Database Configuration (REQUIRED)
# ============================================================================

# PostgreSQL Connection URL (REQUIRED)
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/vcecom
# Used for running migrations and seeding
DATABASE_URL=postgresql://postgres:password@localhost:5432/vcecom

# ============================================================================
# Migration Configuration (Optional)
# ============================================================================

# CI Strict Mode (Optional)
# Set to "true" to enable strict mode in CI environments
# Prevents interactive prompts during migrations
# Default: false (unless CI=true)
CI_STRICT=false

# ============================================================================
# Notes
# ============================================================================
# - This package is used by the backend for database operations
# - Migrations are run via: pnpm db:generate and pnpm db:migrate
# - The backend's DATABASE_URL will be used if this is not set
# - See apps/backend/.env.example for full database configuration
